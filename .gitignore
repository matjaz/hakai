# Cargo build artifacts — both crates redirect `target-dir` off this shared mount (see
# each crate's own .cargo/config.toml) onto local disk on whatever machine builds them,
# but ignore the in-place default too in case that ever changes.
target/

# macOS Finder noise.
.DS_Store
.Trash-1000/

# Editor swap/backup files.
*.swp
*~

# makepkg's own build artifacts: packaging/hakai-git/ is its bare-repo VCS source cache
# (named after the package), packaging/src/ is the working clone built from it,
# packaging/pkg/ is the staged install tree. Real output belongs in a release, not here.
packaging/hakai-git/
packaging/src/
packaging/pkg/
packaging/*.pkg.tar.*
packaging/*.log
